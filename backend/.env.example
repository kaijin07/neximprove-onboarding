# Copy to .env and fill in. .env is git-ignored and must never be committed.

# PostgreSQL connection string.
# Neon dashboard > your project > Connection string.
#
# Neon hands you ?sslmode=require. Change it to verify-full. "require" only
# encrypts the connection, it does not check the server's certificate, so it
# does not protect against a man-in-the-middle. "verify-full" encrypts, checks
# the certificate, and checks the hostname matches.
#
# For a local Docker database, drop the sslmode parameter entirely:
#   postgresql://neximprove:neximprove@localhost:5432/neximprove
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=verify-full"

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="24h"

# bcrypt cost factor. 10 is roughly 100ms per hash.
BCRYPT_SALT_ROUNDS=10

PORT=5000
NODE_ENV=development

# Vite dev server origin, allowed through CORS in development only.
CLIENT_URL=http://localhost:5173
